<?xml version = "1.0" encoding = "UTF-8"?>
<configuration>
    <appender name = "STDOUT" class = "ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5p [%X{userId}] %c{1}.%M -  %m%n</pattern>
        </encoder>
    </appender>

    <root level = "INFO">
        <appender-ref ref = "STDOUT"/>
    </root>
</configuration>